{
    "name": "taba/crm",
    "description": "A reusable CRM package for Laravel.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Taba\\Crm\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Taba\\Crm\\Tests\\": "tests/",
            "Taba\\Crm\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "taba",
            "email": "tabadev217@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "althinect/filament-spatie-roles-permissions": "^3.3.2",
        "asosick/filament-layout-manager": "^2.1",
        "awcodes/filament-curator": "^4.0",
        "awcodes/filament-gravatar": "^3.0",
        "bezhansalleh/filament-exceptions": "^4.2",
        "bezhansalleh/filament-google-analytics": "^3.3",
        "bezhansalleh/filament-shield": "^4.2",
        "croustibat/filament-jobs-monitor": "^4.4",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "diogogpinto/filament-auth-ui-enhancer": "^2.0",
        "filament/filament": "^4.11",
        "google-gemini-php/client": "^2.3",
        "guzzlehttp/guzzle": "^7.9",
        "blade-ui-kit/blade-heroicons": "^2.2",
        "blade-ui-kit/blade-icons": "^1.8",
        "jacobtims/filament-logger": "^1.2",
        "jaocero/radio-deck": "^3.1",
        "jeffgreco13/filament-breezy": "^3.2",
        "guava/filament-icon-picker": "^3.1",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "laravel/sanctum": "^4.0 || ^5.0",
        "laravel/tinker": "^2.9 || ^3.0",
        "livewire/livewire": "^3.3",
        "amidesfahani/filament-tinyeditor": "^4.0",
        "pboivin/filament-peek": "^3.1",
        "romanzipp/laravel-seo": "^2.6",
        "sinnbeck/markdom": "^2.0",
        "spatie/browsershot": "^5.0",
        "spatie/image": "^3.8",
        "spatie/laravel-export": "^1.2",
        "spatie/laravel-sitemap": "^7.3",
        "spatie/laravel-translatable": "^6.0",
        "swisnl/filament-backgrounds": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Taba\\Crm\\CrmServiceProvider"
            ]
        }
    },
    "config": {
        "minimum-stability": "dev",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
